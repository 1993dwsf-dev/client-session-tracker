# Cloudflare Pages: public values (not secrets)
VITE_CONVEX_URL=https://your-fotoflow-deployment.convex.cloud
VITE_ENABLE_GOOGLE_CALENDAR=false

# Convex backend: set privately on YOUR Fotoflow project
# SITE_URL=https://your-project.pages.dev
# CONVEX_SITE_URL=https://your-fotoflow-deployment.convex.site
# JWT_PRIVATE_KEY, JWKS (Convex Auth)
# FOTOFLOW_INVITE_CODE=strong-secret-to-share-with-paying-client

# Optional GitHub Actions secret: CONVEX_DEPLOY_KEY
# Never commit real credentials or reuse credentials from Barber OS.
